<Window x:Class="LinkSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkSync — Phone-to-PC Hardware Continuity" 
        Icon="Resources/app.ico"
        Height="740" Width="1120"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushCanvas}"
        FontFamily="{StaticResource FontPrimary}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Name="ColSidebar" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================== -->
        <!-- COLUMN 0: SIDEBAR (HITS TOP AND BOTTOM OF THE WINDOW)    -->
        <!-- ======================================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <!-- EXPANDED SIDEBAR PANEL -->
                <Grid Name="PanelSidebarExpanded" Margin="14,10,14,12" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- Header: Brand + Collapse Toggle -->
                        <RowDefinition Height="Auto"/> <!-- Interactive Phone Device Card -->
                        <RowDefinition Height="Auto"/> <!-- Notifications Header Strip -->
                        <RowDefinition Height="*"/>    <!-- Scrollable Live Notification Feed -->
                        <RowDefinition Height="Auto"/> <!-- System Telemetry Footer -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar: LinkSync brand + Collapse Toggle -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Hamburger Collapse Button -->
                        <Button Name="BtnToggleSidebar" Style="{StaticResource HeaderIconButton}" 
                                ToolTip="Collapse sidebar" Click="BtnToggleSidebar_Click" VerticalAlignment="Center">
                            <TextBlock Text="&#xE700;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="LinkSync" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Phone Identity & Clickable Mirror Trigger Card -->
                    <Border Grid.Row="1" Background="{StaticResource BrushCard}" CornerRadius="10" Padding="12" Margin="0,0,0,12" 
                            BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Clickable Miniature Phone Frame (Opens 60 FPS Mirror) -->
                            <Button Grid.Row="0" Grid.Column="0" ToolTip="Click to open phone screen (60 FPS low latency)" 
                                    Click="BtnStartMirror_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0">
                                <Border Width="42" Height="62" CornerRadius="8" Background="#141822" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1.5">
                                    <Grid>
                                        <Border Width="12" Height="3" CornerRadius="1" Background="#334155" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="18" 
                                                   Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="MIRROR" FontSize="7" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    </Grid>
                                </Border>
                            </Button>

                            <!-- Device Identity & Status -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Name="TxtSidebarDeviceName" Text="Samsung Galaxy A17" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="One UI Core • Android 14" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="0,1,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Ellipse Name="DotSidebarStatus" Width="7" Height="7" Fill="{StaticResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Name="TxtSidebarStatus" Text="Searching for Phone..." FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushWarning}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Battery & Network Telemetry Badges -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="#12151C" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock Name="TxtSidebarBattery" Text="Auto-Sync" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushSuccess}"/>
                                </Border>
                                <Border Background="#12151C" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock Name="TxtSidebarNet" Text="Wi-Fi / USB" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentLight}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notifications Header Strip -->
                    <Grid Grid.Row="2" Margin="2,0,2,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Notifications" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock Name="TxtNotifCount" Text="" FontSize="11" Foreground="{StaticResource BrushAccentLight}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="2" Name="BtnClearNotifications" Content="Clear all" Style="{StaticResource TopNavTabButton}" 
                                FontSize="11" Foreground="{StaticResource BrushAccentLight}" Padding="4,2" Margin="0" Click="BtnClearNotifications_Click"/>
                    </Grid>

                    <!-- Live Notification Feed -->
                    <ListBox Grid.Row="3" Name="LstNotifications" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Name="NotificationCard" Background="{StaticResource BrushCard}" 
                                                    BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" 
                                                    CornerRadius="8" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="NotificationCard" Property="BorderBrush" Value="{StaticResource BrushCardBorderHover}"/>
                                                    <Setter TargetName="NotificationCard" Property="Background" Value="{StaticResource BrushCardHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icon -->
                                    <Border Grid.Row="0" Grid.Column="0" Width="20" Height="20" CornerRadius="4" Background="#1D2330" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AppIconGlyph}" FontFamily="{StaticResource FontIcons}" FontSize="11" Foreground="{Binding AppIconColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- App Header & Timestamp -->
                                    <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AppName}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}"/>
                                    </Grid>

                                    <!-- Notification Title & Body Text -->
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,4">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Body}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Inline Action Button -->
                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SecondaryButton}" 
                                            HorizontalAlignment="Right" Padding="8,3" FontSize="11" Margin="0,2,0,0"
                                            Tag="{Binding}" Click="NotificationAction_Click">
                                        <TextBlock Text="{Binding ActionLabel}" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Telemetry Footer -->
                    <TextBlock Grid.Row="4" Name="TxtSystemTelemetry" Text="Folio 9470M • Port 54884 • P2P" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>

                <!-- COLLAPSED SIDEBAR RAIL (Width 56) -->
                <Grid Name="PanelSidebarCollapsed" Margin="6,10,6,12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>   <!-- Expand Hamburger -->
                        <RowDefinition Height="*"/>    <!-- Vertical Rail Icons -->
                        <RowDefinition Height="Auto"/> <!-- Settings at bottom -->
                    </Grid.RowDefinitions>

                    <!-- Expand Button at top -->
                    <Button Grid.Row="0" Name="BtnExpandSidebar" Style="{StaticResource HeaderIconButton}" 
                            ToolTip="Expand sidebar" Click="BtnToggleSidebar_Click" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Button>

                    <!-- Vertical Icon Rail -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <!-- Mini Mirror Icon with Dot -->
                        <Grid Margin="0,0,0,10">
                            <Button Name="BtnCompactMirror" Style="{StaticResource HeaderIconButton}" 
                                    ToolTip="Samsung Galaxy A17 • Mirror 60 FPS" Click="BtnStartMirror_Click">
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="16" Foreground="{StaticResource BrushAccentLight}"/>
                            </Button>
                            <Ellipse Name="DotCompactStatus" Width="7" Height="7" Fill="{StaticResource BrushWarning}" 
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Notification Bell with Count Badge -->
                        <Grid Margin="0,0,0,10">
                            <Button Name="BtnCompactNotif" Style="{StaticResource HeaderIconButton}" 
                                    ToolTip="Phone Notifications" Click="BtnCompactNotif_Click">
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource FontIcons}" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Button>
                            <Border Name="BadgeCompactNotif" Width="14" Height="14" CornerRadius="7" Background="{StaticResource BrushAccent}" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" IsHitTestVisible="False">
                                <TextBlock Name="TxtCompactNotifCount" Text="0" FontSize="8" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Snip Icon -->
                        <Button Name="BtnCompactSnip" Style="{StaticResource HeaderIconButton}" Margin="0,0,0,10"
                                ToolTip="Screen Snip (Region capture)" Click="BtnQuickSnip_Click">
                            <TextBlock Text="&#xE7C5;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushSuccess}"/>
                        </Button>

                        <!-- Record Icon -->
                        <Button Name="BtnCompactRecord" Style="{StaticResource HeaderIconButton}" Margin="0,0,0,10"
                                ToolTip="Screen Recording" Click="BtnQuickRecord_Click">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushDanger}"/>
                        </Button>

                        <!-- Annotator Icon -->
                        <Button Name="BtnCompactAnnotator" Style="{StaticResource HeaderIconButton}" Margin="0,0,0,10"
                                ToolTip="Image Annotator (Arrows, step badges, blur &amp; frames)" Click="BtnOpenAnnotator_Click">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushAccentLight}"/>
                        </Button>

                        <!-- Video Suite & GIF Icon -->
                        <Button Name="BtnCompactVideoSuite" Style="{StaticResource HeaderIconButton}" Margin="0,0,0,10"
                                ToolTip="Video Suite &amp; Animated GIF Maker" Click="BtnOpenVideoSuite_Click">
                            <TextBlock Text="&#xEC15;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="#C084FC"/>
                        </Button>

                        <!-- Captures Folder -->
                        <Button Name="BtnCompactFolder" Style="{StaticResource HeaderIconButton}" Margin="0,0,0,10"
                                ToolTip="Open Captures Folder" Click="BtnOpenFolder_Click">
                            <TextBlock Text="&#xED25;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushWarning}"/>
                        </Button>
                    </StackPanel>

                    <!-- Settings at bottom -->
                    <Button Grid.Row="2" Name="BtnCompactSettings" Style="{StaticResource HeaderIconButton}" 
                            ToolTip="Settings &amp; Hardware Configuration" Click="BtnNavSettings_Click" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- COLUMN 1: TOP HEADER & WORKSPACE CONTENT                 -->
        <!-- ======================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Top Header (Starts from sidebar to right window edge!) -->
                <RowDefinition Height="*"/>  <!-- Workspace Active Tab Surface -->
            </Grid.RowDefinitions>

            <!-- TOP HEADER: CLEAN HORIZONTAL TABS & UTILITY ICONS -->
            <Border Grid.Row="0" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>    <!-- Left Horizontal Navigation Tabs -->
                        <ColumnDefinition Width="Auto"/> <!-- Right Quick Utility Actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Horizontal Tabs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnNavMessages" Style="{StaticResource TopNavTabButton}" Click="BtnNavMessages_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Messages" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnNavCalls" Style="{StaticResource TopNavTabButton}" Click="BtnNavCalls_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE717;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Calls" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnNavContacts" Style="{StaticResource TopNavTabButton}" Click="BtnNavContacts_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE779;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Contacts" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnNavPhotos" Style="{StaticResource TopNavTabButton}" Click="BtnNavPhotos_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Photos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Name="BtnNavClipboard" Style="{StaticResource TopNavTabButton}" Click="BtnNavClipboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clipboard" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Top Right Quick Utility Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Name="BtnHeaderAnnotator" Style="{StaticResource HeaderIconButton}" ToolTip="Image Annotator (Arrows, step badges, blur &amp; phone frame)" Margin="0,0,6,0" Click="BtnOpenAnnotator_Click">
                            <TextBlock Text="&#xE790;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushAccentLight}"/>
                        </Button>

                        <Button Name="BtnHeaderVideoSuite" Style="{StaticResource HeaderIconButton}" ToolTip="Video Suite &amp; Animated GIF Maker (Keyframe slicer &amp; GIF)" Margin="0,0,6,0" Click="BtnOpenVideoSuite_Click">
                            <TextBlock Text="&#xEC15;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="#C084FC"/>
                        </Button>

                        <Button Name="BtnHeaderSnip" Style="{StaticResource HeaderIconButton}" ToolTip="Screen Snip (Region capture)" Margin="0,0,6,0" Click="BtnQuickSnip_Click">
                            <TextBlock Text="&#xE7C5;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushSuccess}"/>
                        </Button>

                        <Button Name="BtnHeaderRecord" Style="{StaticResource HeaderIconButton}" ToolTip="Screen Recording" Margin="0,0,6,0" Click="BtnQuickRecord_Click">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushDanger}"/>
                        </Button>

                        <Button Name="BtnHeaderMirror" Style="{StaticResource HeaderIconButton}" ToolTip="Phone Mirror (60 FPS low-latency stream)" Margin="0,0,6,0" Click="BtnStartMirror_Click">
                            <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushAccentLight}"/>
                        </Button>

                        <Button Name="BtnHeaderAdb" Style="{StaticResource HeaderIconButton}" ToolTip="USB ADB Reverse Tunnel Sync" Margin="0,0,6,0" Click="BtnAdbTunnel_Click">
                            <TextBlock Text="&#xEC3E;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushAccentLight}"/>
                        </Button>

                        <Button Name="BtnNavSettings" Style="{StaticResource HeaderIconButton}" ToolTip="Settings &amp; Hardware Configuration" Click="BtnNavSettings_Click">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushTextSecondary}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WORKSPACE CONTENT (Grid.Row="1") -->
            <Grid Grid.Row="1" Margin="20,16,20,16">
                <!-- Hidden Backing Elements for Internal Event Handlers & Backward Compatibility -->
                <Grid Visibility="Collapsed">
                    <Button Name="BtnNavOverview" Click="BtnNavOverview_Click"/>
                    <Button Name="BtnNavVideo" Click="BtnNavVideo_Click"/>
                    <Button Name="BtnNavAnnotator" Click="BtnNavAnnotator_Click"/>
                    <Button Name="BtnNavMirror" Click="BtnNavMirror_Click"/>
                    <Button Name="BtnSidebarSnip" Click="BtnSidebarSnip_Click"/>
                    <Button Name="BtnSidebarRecord" Click="BtnSidebarRecord_Click"/>
                    <Button Name="BtnOpenFolder" Click="BtnOpenFolder_Click"/>
                    <Button Name="BtnAdbTunnel" Click="BtnAdbTunnel_Click"/>
                    <Button Name="BtnQuickMirror" Click="BtnStartMirror_Click"/>
                    <Button Name="BtnQuickSnip" Click="BtnQuickSnip_Click"/>
                    <Button Name="BtnQuickRecord" Click="BtnQuickRecord_Click"/>
                    <TextBlock Name="TxtPageTitle"/>
                    <TextBlock Name="TxtHeaderSub"/>
                    <Ellipse Name="DotStatus"/>
                    <TextBlock Name="TxtDeviceName"/>
                    <TextBlock Name="TxtDeviceSub"/>
                </Grid>

                <!-- ==================================================== -->
                <!-- DEFAULT LAUNCH VIEW: WELCOME & CONTINUITY CANVAS     -->
                <!-- ==================================================== -->
                <Grid Name="ViewWelcome" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Welcome Banner -->
                    <Border Grid.Row="0" Style="{StaticResource HeroContinuityDeck}" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="12" Background="#141B2D" 
                                    BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Margin="0,0,18,0" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="28" 
                                           Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="LinkSync Continuity" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="Select a category from the top navigation bar to open Messages, Calls, Contacts, Photos, or Clipboard." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick Tools Launch Matrix -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Quick Power Tools" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>

                        <UniformGrid Grid.Row="1" Columns="2" Rows="2" VerticalAlignment="Top">
                            <!-- Tool 1: Image Annotator -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,12" Height="100" Padding="16" HorizontalContentAlignment="Left" Click="BtnOpenAnnotator_Click" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#102A45" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE790;" FontFamily="{StaticResource FontIcons}" FontSize="20" Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Image Annotator" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Add arrows, numbered step badges, blur redaction, and Samsung phone mockups to screenshots." FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tool 2: Video Suite & GIF -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,12" Height="100" Padding="16" HorizontalContentAlignment="Left" Click="BtnOpenVideoSuite_Click" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#261233" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEC15;" FontFamily="{StaticResource FontIcons}" FontSize="20" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Video Suite &amp; GIF Maker" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Lossless keyframe video trimming and high-quality 2-pass Lanczos animated GIF generation." FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tool 3: Screen Mirror -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Height="100" Padding="16" HorizontalContentAlignment="Left" Click="BtnStartMirror_Click" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#162B23" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="20" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Phone Mirror (60 FPS)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Ultra-low latency hardware stream with remote mouse click control and laptop keyboard typing." FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Tool 4: Captures Folder -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="100" Padding="16" HorizontalContentAlignment="Left" Click="BtnOpenFolder_Click" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Background="#261E14" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xED25;" FontFamily="{StaticResource FontIcons}" FontSize="20" Foreground="{StaticResource BrushWarning}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Open Captures Folder" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <TextBlock Text="Direct access to synced screenshots, annotated PNGs, and screen recording MP4 files." FontSize="11" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- ==================================================== -->
                <!-- TAB 1: OVERVIEW (COLLAPSED BY DEFAULT)               -->
                <!-- ==================================================== -->
                <Grid Name="ViewOverview" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Hero Continuity Deck -->
                    <RowDefinition Height="*"/>    <!-- 2x2 Balanced Action Matrix -->
                </Grid.RowDefinitions>

                <!-- Hero Continuity Deck -->
                <Border Grid.Row="0" Style="{StaticResource HeroContinuityDeck}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Device Silhouette Container -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#1A202C" 
                                BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="24" 
                                       Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Middle Continuity Status -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Name="DotOverviewStatus" Width="10" Height="10" Fill="{StaticResource BrushWarning}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Name="TxtOverviewDeviceName" Text="Searching for Galaxy A17 on Local Wi-Fi &amp; USB..." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                            </StackPanel>
                            
                            <TextBlock Name="TxtOverviewDeviceSub" Text="Ensure LinkSync is running on your phone or connect via USB cable." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="18,3,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                <Border Background="#12151C" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="Two-Way Clipboard: ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                                </Border>
                                <Border Background="#12151C" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="QuickSync H.264: READY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}"/>
                                </Border>
                                <Border Background="#12151C" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="Auto-Paste: ON" FontSize="10" FontWeight="Bold" Foreground="#A78BFA"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Quick Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Name="BtnStartMirror" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="BtnStartMirror_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mirror Screen (60 FPS)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Name="BtnScreenOffMirror" Style="{StaticResource SecondaryButton}" ToolTip="Turn phone display black to save battery while mirroring" Click="BtnScreenOffMirror_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC46;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource BrushAccentLight}"/>
                                    <TextBlock Text="Screen-Off" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2x2 Balanced Action Matrix -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: Screen Snip & Capture -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#064E3B" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE7C5;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Screen Capture &amp; Snip" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="ShareX-grade crosshair &amp; region capture" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Snip any region on your laptop with live pixel coordinates. Automatically copies to your clipboard and syncs to your phone in sub-50ms." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,10" TextWrapping="Wrap" LineHeight="17"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="Region Snip" Style="{StaticResource PrimaryButton}" Background="{StaticResource BrushSuccess}" Margin="0,0,6,0" Click="BtnQuickSnip_Click"/>
                                <Button Content="Active Window" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnWindowSnip_Click"/>
                                <Button Content="Entire Screen" Style="{StaticResource SecondaryButton}" Click="BtnFullscreenSnip_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Image Annotator -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#4A044E" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="#F472B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Image Annotator" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Step numbers, arrows, blur redaction &amp; mockups" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Annotate bug screenshots with auto-incrementing step badges (①, ②, ③), vector arrows, pixelate/blur redactions, spotlight dimmer, and 1-tap Samsung Galaxy chassis mockups." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,10" TextWrapping="Wrap" LineHeight="17"/>

                            <Button Grid.Row="2" Name="BtnOpenAnnotator" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnOpenAnnotator_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#F472B6"/>
                                    <TextBlock Text="Launch Annotator" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Card 3: Video Suite & Screen Recording -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,8,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="6" Background="#3B0764" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Video Suite &amp; Screen Recording" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Lossless keyframe trimmer &amp; high-FPS GIF maker" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Record high-fidelity H.264 screen recordings. Trim videos instantly with zero CPU re-encode (-c copy) or convert recordings to 2-pass Lanczos palette animated GIFs." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,10" TextWrapping="Wrap" LineHeight="17"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="Record Region" Style="{StaticResource PrimaryButton}" Background="{StaticResource BrushDanger}" Margin="0,0,6,0" Click="BtnSidebarRecord_Click"/>
                                <Button Content="Record Fullscreen" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnFullscreenRecord_Click"/>
                                <Button Name="BtnOpenVideoSuite" Content="Open Suite" Style="{StaticResource SecondaryButton}" Click="BtnOpenVideoSuite_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 4: Universal Clipboard Stream -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource BrushAccentSubtle}" Margin="0,0,10,0">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource FontIcons}" FontSize="14" Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Universal Clipboard Stream" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Text="Bi-directional zero-latency copy &amp; paste bridge" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="Copy text on either device and paste instantly on the other. Includes loop isolation suppression, historical audit log, and instant re-copy buttons." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,10,0,10" TextWrapping="Wrap" LineHeight="17"/>

                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="Open Clipboard Stream" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnNavClipboard_Click"/>
                                <Button Content="Clear Stream" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource BrushDanger}" Click="BtnClearClipboardDesktop_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB: MESSAGES (TWO-PANE PHONE LINK LAYOUT)               -->
            <!-- ======================================================== -->
            <Grid Name="ViewMessages" Grid.Row="1" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Conversations List -->
                <Border Grid.Column="0" Background="{StaticResource BrushCard}" CornerRadius="8" 
                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Margin="0,0,12,0">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box & Refresh -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxtSmsSearch" Style="{StaticResource ModernTextBox}" 
                                     Tag="Search messages..." TextChanged="TxtSmsSearch_TextChanged"/>
                            <Button Grid.Column="1" Name="BtnRefreshSms" Style="{StaticResource SecondaryButton}" 
                                    Margin="6,0,0,0" ToolTip="Sync latest messages from phone" Click="BtnRefreshSms_Click">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcons}" FontSize="13" Foreground="{StaticResource BrushAccentLight}"/>
                            </Button>
                        </Grid>

                        <!-- Conversations List -->
                        <ListBox Grid.Row="1" Name="LstSmsThreads" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="LstSmsThreads_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushCardHover}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right Pane: Active Thread Chat Stream -->
                <Border Grid.Column="1" Background="{StaticResource BrushCard}" CornerRadius="8" 
                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Thread Header -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar Initial -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBlock Name="TxtActiveAvatar" Text="&#xE8BD;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Name="TxtActiveThreadName" Text="Select a Conversation" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                    <TextBlock Name="TxtActiveThreadNumber" Text="Direct SMS via Galaxy A17" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Name="BtnCallActiveThread" Style="{StaticResource SecondaryButton}" Click="BtnCallActiveThread_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE717;" FontFamily="{StaticResource FontIcons}" FontSize="13" Foreground="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Call Contact" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Scrollable Message Bubbles -->
                        <ScrollViewer Grid.Row="1" Name="ScrollSmsMessages" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,8">
                            <StackPanel Name="PnlSmsMessages" Orientation="Vertical"/>
                        </ScrollViewer>

                        <!-- Bottom Composition Bar -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxtSmsInput" Style="{StaticResource ModernTextBox}" Tag="Type an SMS message (Enter to send)..." KeyDown="TxtSmsInput_KeyDown" MaxLength="1000" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Name="BtnSendSms" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Height="36" Width="44" ToolTip="Send SMS via connected phone" Click="BtnSendSms_Click">
                                <TextBlock Text="&#xE724;" FontFamily="{StaticResource FontIcons}" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB: CALLS & DIALER (PHONE LINK KEYPAD & CONTROLS)       -->
            <!-- ======================================================== -->
            <Grid Name="ViewCalls" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Digital Dialer Keypad -->
                <Border Grid.Column="0" Background="{StaticResource BrushCard}" CornerRadius="8" 
                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Margin="0,0,12,0" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- In-Call Status Banner (Visible during active call) -->
                        <Border Grid.Row="0" Name="CardActiveCall" Visibility="Collapsed" Background="#064E3B" BorderBrush="{StaticResource BrushSuccess}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="TxtActiveCallNumber" Text="+1 (555) 019-2834" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Name="TxtActiveCallState" Text="Calling..." FontSize="11" Foreground="{StaticResource BrushSuccess}" Margin="0,0,8,0"/>
                                        <TextBlock Name="TxtActiveCallTimer" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Name="BtnEndCall" Style="{StaticResource DangerButton}" Height="34" Width="80" Click="BtnEndCall_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource FontIcons}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="End" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Dial Number Display & Backspace -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxtDialNumber" Style="{StaticResource ModernTextBox}" FontSize="20" FontWeight="SemiBold" 
                                     Tag="Enter number to dial..." Height="44" Padding="10,6" KeyDown="TxtDialNumber_KeyDown"/>
                            <Button Grid.Column="1" Name="BtnDialBackspace" Style="{StaticResource SecondaryButton}" Height="44" Width="44" Margin="6,0,0,0" ToolTip="Backspace" Click="BtnDialBackspace_Click">
                                <TextBlock Text="&#xE750;" FontFamily="{StaticResource FontIcons}" FontSize="15" Foreground="{StaticResource BrushTextMuted}"/>
                            </Button>
                        </Grid>

                        <!-- 3x4 Tactile Keypad Grid -->
                        <UniformGrid Grid.Row="2" Rows="4" Columns="3" Margin="0,0,0,14">
                            <!-- Row 1 -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="2">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="2" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="A B C" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="3">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="3" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="D E F" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <!-- Row 2 -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="4" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="G H I" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="5">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="5" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="J K L" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="6">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="6" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="M N O" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <!-- Row 3 -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="7">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="7" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="P Q R S" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="8" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="T U V" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="9">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="9" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="W X Y Z" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <!-- Row 4 -->
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="*">
                                <TextBlock Text="*" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="+" FontSize="9" Foreground="{StaticResource BrushTextMuted}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Margin="4" Height="48" Click="KeypadDigit_Click" Tag="#">
                                <TextBlock Text="#" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </UniformGrid>

                        <!-- Call Trigger Button -->
                        <Button Grid.Row="3" Name="BtnPlaceCall" Style="{StaticResource PrimaryButton}" Background="{StaticResource BrushSuccess}" 
                                Height="44" FontSize="14" FontWeight="Bold" Click="BtnPlaceCall_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE717;" FontFamily="{StaticResource FontIcons}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Call on Galaxy A17" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Pane: Fast Dial & Call Tips -->
                <Border Grid.Column="1" Background="{StaticResource BrushCard}" CornerRadius="8" 
                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Quick Dial &amp; Recent Contacts" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>

                        <ListBox Grid.Row="1" Name="LstQuickDial" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Name="CardBorder" Background="#161922" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource BrushCardHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB: CONTACTS DIRECTORY (SYNCED PHONE BOOK)              -->
            <!-- ======================================================== -->
            <Grid Name="ViewContacts" Grid.Row="1" Visibility="Collapsed">
                <Border Background="{StaticResource BrushCard}" CornerRadius="8" 
                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search, Count & Sync Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Name="TxtContactSearch" Style="{StaticResource ModernTextBox}" 
                                     Tag="Search contacts by name or phone number..." TextChanged="TxtContactSearch_TextChanged"/>

                            <Border Grid.Column="1" Background="#12151C" CornerRadius="4" Padding="10,6" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Name="TxtContactsCount" Text="0 Contacts" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>

                            <Button Grid.Column="2" Name="BtnRefreshContacts" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnRefreshContacts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcons}" FontSize="13" Foreground="{StaticResource BrushAccentLight}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sync Phonebook" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Contacts List -->
                        <ListBox Grid.Row="1" Name="LstContacts" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Name="CardBorder" Background="#161922" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource BrushCardHover}"/>
                                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#334155"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 2: PHOTOS & SCREENSHOTS GALLERY                      -->
            <!-- ======================================================== -->
            <Grid Name="ViewPhotos" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Synced Screenshots &amp; Photos Gallery" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="✏️ Image Annotator" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnOpenAnnotator_Click" ToolTip="Annotate image with arrows, steps, blur redaction &amp; phone frame"/>
                        <Button Content="🎬 Video Suite &amp; GIF" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnOpenVideoSuite_Click" ToolTip="Lossless video trimming and animated GIF maker"/>
                        <Button Content="Snip Region" Style="{StaticResource PrimaryButton}" Background="{StaticResource BrushSuccess}" Margin="0,0,6,0" Click="BtnQuickSnip_Click"/>
                        <Button Content="Fullscreen" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnFullscreenSnip_Click"/>
                        <Button Content="Record Screen" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="BtnQuickRecord_Click"/>
                        <Button Content="Open Folder" Style="{StaticResource SecondaryButton}" Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                    <ListBox Name="LstMedia" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="LstMedia_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12151C" CornerRadius="8" Padding="12" Margin="0,0,0,8" 
                                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Preview Thumbnail Frame -->
                                        <Border Width="60" Height="60" CornerRadius="6" Background="#0A0C10" Margin="0,0,12,0" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <TextBlock Text="&#xE714;" FontFamily="{StaticResource FontIcons}" FontSize="20" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" FontSize="13"/>
                                            <TextBlock Text="{Binding TimestampText}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionButtonText}" FontSize="11" Padding="12,6" 
                                                    Background="{Binding ActionButtonBackground}" Foreground="White" 
                                                    BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"
                                                    Click="BtnMediaAction_Click"/>
                                            <Button Content="Re-copy" Style="{StaticResource SecondaryButton}" FontSize="11" Padding="10,6" Click="BtnCopyMediaItem_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 3: UNIVERSAL CLIPBOARD STREAM                        -->
            <!-- ======================================================== -->
            <Grid Name="ViewClipboard" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Universal Clipboard Stream (Samsung DeX Grade)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="BtnClearClipboardDesktop" Content="Clear Stream" Style="{StaticResource SecondaryButton}" Foreground="{StaticResource BrushDanger}" Click="BtnClearClipboardDesktop_Click"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                    <ListBox Name="LstClipboard" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#12151C" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" 
                                        BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header: Source Badge & Timestamp -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding SourceColor}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Content Body -->
                                        <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" LineHeight="18"/>

                                        <!-- Footer: Character Count & Re-copy Button -->
                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding CharCountText}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                                            <Button Content="Copy to Clipboard" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" FontSize="10" Padding="8,3" Click="BtnRecopyClipboard_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Push Clipboard Manually Input -->
                <TextBox Name="TxtManualClipboard" Grid.Row="2" Style="{StaticResource ModernTextBox}" Margin="0,12,0,0" 
                         Text="Type text here and hit Enter to push to Galaxy A17..." KeyDown="TxtManualClipboard_KeyDown"/>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 4: VIDEO SUITE LAUNCHER                              -->
            <!-- ======================================================== -->
            <Grid Name="ViewVideo" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <Border Width="56" Height="56" CornerRadius="12" Background="#3B0764" BorderBrush="#581C87" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource FontIcons}" FontSize="28" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <TextBlock Text="Video Suite &amp; Lossless GIF Maker" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hardware-accelerated MP4 playback, sub-second lossless keyframe cutting (-c copy), and 2-pass Lanczos palette animated GIF generation." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,10,0,24" TextWrapping="Wrap" LineHeight="18"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Launch Video Suite" Style="{StaticResource PrimaryButton}" Background="#7C3AED" FontSize="13" Padding="18,10" Margin="0,0,8,0" Click="BtnOpenVideoSuite_Click"/>
                            <Button Content="Record Region" Style="{StaticResource SecondaryButton}" FontSize="13" Padding="14,10" Click="BtnSidebarRecord_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 5: ANNOTATOR LAUNCHER                                -->
            <!-- ======================================================== -->
            <Grid Name="ViewAnnotator" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <Border Width="56" Height="56" CornerRadius="12" Background="#4A044E" BorderBrush="#701A75" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource FontIcons}" FontSize="28" Foreground="#F472B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="ShareX-Grade Image Annotator" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vector arrows, auto-incrementing bug step badges (①, ②, ③), blur/pixelate redactions, spotlight dimmer, and realistic Samsung Galaxy chassis frame mockups." FontSize="13" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,10,0,24" TextWrapping="Wrap" LineHeight="18"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Open Image Annotator" Style="{StaticResource PrimaryButton}" Background="#DB2777" FontSize="13" Padding="18,10" Margin="0,0,8,0" Click="BtnOpenAnnotator_Click"/>
                            <Button Content="Snip Region to Annotate" Style="{StaticResource SecondaryButton}" FontSize="13" Padding="14,10" Click="BtnQuickSnip_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 6: PHONE MIRROR & REMOTE CONTROL                     -->
            <!-- ======================================================== -->
            <Grid Name="ViewMirror" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- Hero Card -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Real-Time Phone Mirror &amp; Remote Control" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                        <Border Background="{StaticResource BrushAccentSubtle}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="60 FPS • QuickSync H.264" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}"/>
                                        </Border>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Hardware-accelerated 60 FPS H.264 stream decoded by Intel QuickSync GPU with full mouse clicks, swipes, and physical laptop keyboard typing." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <Border Name="BadgeMirrorActive" Background="{StaticResource BrushSuccessBg}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" Visibility="Collapsed">
                                            <TextBlock Text="Stream Active (60 FPS)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushSuccess}"/>
                                        </Border>
                                        <Border Name="BadgeMirrorInactive" Background="#12151C" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="Mirror Idle" FontSize="11" FontWeight="Medium" Foreground="{StaticResource BrushTextMuted}"/>
                                        </Border>
                                        <Border Background="#12151C" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                            <TextBlock Text="QuickSync H.264" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                        </Border>
                                        <Border Background="#12151C" CornerRadius="4" Padding="8,3">
                                            <TextBlock Text="Latency &lt; 50ms" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Name="BtnTabStartMirror" Content="Launch Mirror" Style="{StaticResource PrimaryButton}" FontSize="13" Padding="16,10" Margin="0,0,8,0" Click="BtnStartMirror_Click"/>
                                    <Button Name="BtnTabScreenOffMirror" Content="Screen-Off Mirror" Style="{StaticResource SecondaryButton}" FontSize="13" Padding="14,10" Click="BtnScreenOffMirror_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Two-Column Cards: Shortcuts Cheat Sheet & Multi-Tasking Architecture -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Shortcuts Cheat Sheet -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Mouse &amp; Physical Keyboard Controls" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Left Click / Drag" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushAccentLight}"/>
                                        <TextBlock Text="Tap &amp; swipe phone display" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Right-Click" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushAccentLight}"/>
                                        <TextBlock Text="Android Back Button" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Middle-Click" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushAccentLight}"/>
                                        <TextBlock Text="Android Home Button" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Laptop Keyboard" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushSuccess}"/>
                                        <TextBlock Text="Direct typing into phone text inputs" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Alt + F / F11" FontSize="12" FontWeight="Medium" Foreground="{StaticResource BrushWarning}"/>
                                        <TextBlock Text="Toggle Fullscreen Window" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Alt + O" FontSize="12" FontWeight="Medium" Foreground="#A78BFA"/>
                                        <TextBlock Text="Turn Physical Screen Off (Battery Saver)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right: Architecture & Ergonomics -->
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Why a Floating Window is Superior" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Snap Side-by-Side: Press Win + Left/Right to dock your phone right next to VS Code, Notion, or your browser." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="16"/>
                                    <TextBlock Text="Dual Monitor Freedom: Place the phone mirror onto a second monitor while working on laptop." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="16"/>
                                    <TextBlock Text="Zero Terminal Clutter: The scrcpy console process is completely suppressed. You only see the high-framerate phone stream." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ======================================================== -->
            <!-- TAB 7: DEDICATED SETTINGS VIEW                           -->
            <!-- ======================================================== -->
            <Grid Name="ViewSettings" Grid.Row="1" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- Group 1: Storage & Directories -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Storage &amp; Auto-Save Directory" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Location where synced screenshots, video recordings, and exports are saved on your HP Folio 9470M." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="TxtSettingsSaveDir" Style="{StaticResource ModernTextBox}" IsReadOnly="True" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Name="BtnChangeSaveDir" Content="Change..." Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BtnChangeSaveDir_Click"/>
                                    <Button Grid.Column="2" Name="BtnSettingsOpenFolder" Content="Open in Explorer" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Click="BtnOpenFolder_Click"/>
                                </Grid>

                                <CheckBox Name="ChkAutoPasteClipboard" Content="Auto-copy received screenshots to Windows Clipboard for immediate Ctrl + V" 
                                          Foreground="{StaticResource BrushTextSecondary}" FontSize="12" IsChecked="True" Click="ChkAutoPasteClipboard_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Group 2: Startup & Background Behavior -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Startup &amp; Background Execution" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Configure how LinkSync operates when Windows starts and when the window is closed." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>

                                <CheckBox Name="ChkRunOnStartup" Content="Start LinkSync automatically when Windows boots (starts minimized to system tray)" 
                                          Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,12" Click="ChkRunOnStartup_Click"/>

                                <Border Background="#12151C" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource FontIcons}" FontSize="18" Foreground="{StaticResource BrushAccentLight}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Background System Tray Bridge Active" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <TextBlock Text="Closing this window minimizes LinkSync to the Windows System Tray so screenshots and clipboards continue syncing in real-time." FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Group 3: Hardware Decoding Engine -->
                        <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Hardware Acceleration &amp; Decoding" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Verified hardware specs for your HP EliteBook Folio 9470M receiver." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="GPU Decoding Engine:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"/>
