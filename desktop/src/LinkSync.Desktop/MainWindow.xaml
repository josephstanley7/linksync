<Window x:Class="LinkSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkSync - Native Phone-to-PC Bridge" 
        Icon="Resources/app.ico"
        Height="680" Width="980"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120">

    <Window.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Modern Action Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Phone Link Navigation Button -->
        <Style x:Key="NavRailButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- LEFT SIDEBAR RAIL (MICROSOFT PHONE LINK) -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid Margin="14,16,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Device Header Card (Phone Link Style) -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="14" Margin="0,0,0,20" BorderBrush="#334155" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Device Icon -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="📱" FontSize="26" Margin="0,0,10,4" VerticalAlignment="Center"/>

                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Name="TxtSidebarDeviceName" Text="Galaxy A17" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Samsung One UI" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>

                        <!-- Live Status Dot & Connection State -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,8" VerticalAlignment="Center">
                            <Ellipse Name="DotSidebarStatus" Width="10" Height="10" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Name="TxtSidebarStatus" Text="Searching for Phone..." FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B"/>
                        </StackPanel>

                        <!-- Hardware Info Pills: Battery & Wi-Fi -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <Border Background="#0F172A" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                <TextBlock Name="TxtSidebarBattery" Text="🔋 85%" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                            </Border>
                            <Border Background="#0F172A" CornerRadius="6" Padding="8,3">
                                <TextBlock Name="TxtSidebarNet" Text="📶 Local Wi-Fi" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Navigation Items (Phone Link Tabs) -->
                <StackPanel Grid.Row="1" Orientation="Vertical">
                    <Button Name="BtnNavOverview" Content="🔗   Overview" Style="{StaticResource NavRailButton}" Background="#1E293B" Foreground="#38BDF8" Click="BtnNavOverview_Click"/>
                    <Button Name="BtnNavPhotos" Content="📸   Photos &amp; Screenshots" Style="{StaticResource NavRailButton}" Click="BtnNavPhotos_Click"/>
                    <Button Name="BtnNavClipboard" Content="📋   Clipboard Stream" Style="{StaticResource NavRailButton}" Click="BtnNavClipboard_Click"/>
                    <Button Name="BtnNavVideo" Content="🎬   Video Suite" Style="{StaticResource NavRailButton}" Click="BtnNavVideo_Click"/>
                    <Button Name="BtnNavAnnotator" Content="✏️   Image Annotator" Style="{StaticResource NavRailButton}" Click="BtnNavAnnotator_Click"/>
                </StackPanel>

                <!-- 3. Bottom Quick Action Button: ShareX Snip -->
                <StackPanel Grid.Row="2" Orientation="Vertical">
                    <Button Name="BtnSidebarSnip" Content="📸   Snip Screen (ShareX)" Style="{StaticResource PrimaryButton}" 
                            Background="#10B981" Foreground="White" FontSize="12" Margin="0,0,0,8"
                            Click="BtnSidebarSnip_Click"/>
                    <TextBlock Text="HP Folio 9470M Receiver" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- RIGHT CONTENT AREA (DYNAMIC TAB VIEWS)   -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Action Strip -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="TxtPageTitle" Text="Overview &amp; Hardware Status" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Name="TxtHeaderSub" Text="Folio 9470M &lt;—&gt; Galaxy A17 | Zero-Config Auto Bridge Active" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnOpenFolder" Content="📁 Screenshots" Style="{StaticResource PrimaryButton}" Background="#1E293B" Foreground="#94A3B8" Margin="0,0,6,0" Click="BtnOpenFolder_Click"/>
                    <Button Name="BtnAdbTunnel" Content="⚡ USB ADB" Style="{StaticResource PrimaryButton}" Background="#1E293B" Foreground="#94A3B8" Margin="0,0,6,0" Click="BtnAdbTunnel_Click"/>
                    <Button Name="BtnQuickSnip" Content="📸 Snip" Style="{StaticResource PrimaryButton}" Background="#2563EB" Click="BtnQuickSnip_Click"/>
                </StackPanel>
            </Grid>

            <!-- TAB 1: OVERVIEW VIEW -->
            <Grid Name="ViewOverview" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Status Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Name="DotStatus" Width="14" Height="14" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Name="TxtDeviceName" Text="Searching for Phone (Listening on Port 54884)..." FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Name="TxtDeviceSub" Text="Open LinkSync on your Galaxy A17 or connect via USB cable." FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="Two-Way Clipboard: ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                            <TextBlock Text="Instant Auto-Paste: ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Feature Quick Launch Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Card 1: ShareX Region Snip -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,8,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📸 ShareX Screen Capture" FontSize="15" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Grid.Row="1" Text="Interactive region snip with crosshair coordinates, un-dimmed cutout, and instant sync to phone &amp; clipboard." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Button Grid.Row="2" Content="Take Region Snip (ShareX)" Style="{StaticResource PrimaryButton}" Background="#10B981" Click="BtnQuickSnip_Click"/>
                        </Grid>
                    </Border>

                    <!-- Card 2: Fullscreen & Window Snip -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🖥️ Window &amp; Fullscreen Snip" FontSize="15" FontWeight="Bold" Foreground="#A7F3D0"/>
                            <TextBlock Grid.Row="1" Text="Instant capture of your active foreground window or entire desktop. Automatically copies to clipboard and syncs to phone." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="🖥️ Entire Screen" Style="{StaticResource PrimaryButton}" Background="#0284C7" Margin="0,0,8,0" Click="BtnFullscreenSnip_Click"/>
                                <Button Content="🪟 Active Window" Style="{StaticResource PrimaryButton}" Background="#334155" Click="BtnWindowSnip_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Image Annotator -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,8,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="✏️ Image Annotator" FontSize="15" FontWeight="Bold" Foreground="#F472B6"/>
                            <TextBlock Grid.Row="1" Text="Vector arrows, auto-incrementing step badges (①, ②, ③), blur/pixelate redactions, and 1-click Samsung Galaxy phone frames." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Button Grid.Row="2" Name="BtnOpenAnnotator" Content="Open Annotator" Style="{StaticResource PrimaryButton}" Background="#DB2777" Click="BtnOpenAnnotator_Click"/>
                        </Grid>
                    </Border>

                    <!-- Card 4: Video Suite & GIF -->
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardPanel}" Margin="8,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="🎬 Video Suite &amp; Lossless GIF" FontSize="15" FontWeight="Bold" Foreground="#C084FC"/>
                            <TextBlock Grid.Row="1" Text="Sub-second keyframe video trimming and crystal-clear animated GIF conversion optimized for GitHub &amp; Slack." FontSize="12" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <Button Grid.Row="2" Name="BtnOpenVideoSuite" Content="Open Video Suite" Style="{StaticResource PrimaryButton}" Background="#7C3AED" Click="BtnOpenVideoSuite_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- TAB 2: PHOTOS & SCREENSHOTS VIEW -->
            <Grid Name="ViewPhotos" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📸 Synced Screenshots &amp; Photos Gallery" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="📸 Snip Region" Style="{StaticResource PrimaryButton}" Background="#10B981" Margin="0,0,6,0" Click="BtnQuickSnip_Click"/>
                        <Button Content="🖥️ Fullscreen" Style="{StaticResource PrimaryButton}" Background="#0284C7" Margin="0,0,6,0" Click="BtnFullscreenSnip_Click"/>
                        <Button Content="📁 Open Folder" Style="{StaticResource PrimaryButton}" Background="#334155" Click="BtnOpenFolder_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                    <ListBox Name="LstMedia" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="LstMedia_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151D2A" CornerRadius="10" Padding="12" Margin="0,0,0,10" BorderBrush="#232F42" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Preview Thumbnail Frame -->
                                        <Border Width="64" Height="64" CornerRadius="8" Background="#0B0F17" Margin="0,0,14,0" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <!-- Video / Fallback Badge -->
                                                <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVideo}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="#F8FAFC" FontSize="13"/>
                                            <TextBlock Text="{Binding TimestampText}" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding ActionButtonText}" FontSize="11" Padding="12,6" 
                                                    Background="{Binding ActionButtonBackground}" Foreground="White" 
                                                    BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"
                                                    Click="BtnMediaAction_Click"/>
                                            <Button Content="📋 Re-copy" FontSize="11" Padding="10,6" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="BtnCopyMediaItem_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <!-- TAB 3: CLIPBOARD STREAM VIEW -->
            <Grid Name="ViewClipboard" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📋 Universal Clipboard Stream (Samsung DeX Style)" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="BtnClearClipboardDesktop" Content="🗑 Clear Stream" Style="{StaticResource PrimaryButton}" Background="#334155" Foreground="#EF4444" Click="BtnClearClipboardDesktop_Click"/>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardPanel}">
                    <ListBox Name="LstClipboard" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="8" Padding="14,12" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Header: Source Badge & Timestamp -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SourceLabel}" FontSize="11" FontWeight="Bold" Foreground="{Binding SourceColor}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Content Body -->
                                        <TextBlock Grid.Row="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="#F8FAFC" LineHeight="18"/>

                                        <!-- Footer: Character Count & Re-copy Button -->
                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding CharCountText}" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <Button Content="📋 Re-copy" HorizontalAlignment="Right" FontSize="10" Padding="10,3" 
                                                    Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" 
                                                    Cursor="Hand" Click="BtnRecopyClipboard_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Push Clipboard Manually Input -->
                <TextBox Name="TxtManualClipboard" Grid.Row="2" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="10" Margin="0,12,0,0" Text="Type text here and hit Enter to push to Galaxy A17..." KeyDown="TxtManualClipboard_KeyDown"/>
            </Grid>

            <!-- TAB 4: VIDEO SUITE LAUNCHER VIEW -->
            <Grid Name="ViewVideo" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="🎬 Video Suite &amp; Lossless GIF Maker" FontSize="22" FontWeight="Bold" Foreground="#C084FC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hardware-accelerated MP4 playback, sub-second lossless keyframe cutting (-c copy), and 2-pass Lanczos palette animated GIF generation." FontSize="13" Foreground="#94A3B8" TextAlignment="Center" Margin="0,10,0,24" TextWrapping="Wrap"/>
                        <Button Content="🎬 Open Video Suite" Style="{StaticResource PrimaryButton}" Background="#7C3AED" FontSize="14" Padding="20,12" HorizontalAlignment="Center" Click="BtnOpenVideoSuite_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TAB 5: ANNOTATOR LAUNCHER VIEW -->
            <Grid Name="ViewAnnotator" Grid.Row="1" Visibility="Collapsed">
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="✏️ ShareX-Grade Image Annotator" FontSize="22" FontWeight="Bold" Foreground="#F472B6" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vector arrows, auto-incrementing bug step badges (①, ②, ③), blur/pixelate redactions, spotlight dimmer, and realistic Samsung Galaxy A chassis frame mockups." FontSize="13" Foreground="#94A3B8" TextAlignment="Center" Margin="0,10,0,24" TextWrapping="Wrap"/>
                        <Button Content="✏️ Open Image Annotator" Style="{StaticResource PrimaryButton}" Background="#DB2777" FontSize="14" Padding="20,12" HorizontalAlignment="Center" Click="BtnOpenAnnotator_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
