<Window x:Class="LinkSync.Desktop.Views.ScreenRecordingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkSync Recording Toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseDown="Window_MouseDown">

    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="10" Padding="10,6" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 1. Blinking REC Indicator -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Ellipse Name="DotRec" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="DotRec"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1.0" To="0.15" Duration="0:0:0.6"
                                                     AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="REC" FontSize="11" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Live Timer Readout -->
            <TextBlock Name="TxtDuration" Text="00:00:00" FontSize="13" FontWeight="Bold" FontFamily="Consolas, Segoe UI" Foreground="#F8FAFC" VerticalAlignment="Center" Margin="0,0,12,0"/>

            <!-- 3. Resolution Tag -->
            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Name="TxtResolution" Text="1920 × 1080" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
            </Border>

            <!-- 4. Divider -->
            <Border Width="1" Background="#334155" Margin="0,2,10,2"/>

            <!-- 5. Pause / Resume Button -->
            <Button Name="BtnPauseResume" Content="⏸ Pause" Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11" Padding="8,4" Margin="0,0,6,0" Cursor="Hand" Click="BtnPauseResume_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 6. Stop Button (ShareX style) -->
            <Button Name="BtnStop" Content="⏹ Stop" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="11" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" Click="BtnStop_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 7. Abort / Discard Button -->
            <Button Name="BtnAbort" Content="✕" ToolTip="Abort &amp; Discard Recording" Background="#1E293B" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" Padding="6,4" Cursor="Hand" Click="BtnAbort_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
