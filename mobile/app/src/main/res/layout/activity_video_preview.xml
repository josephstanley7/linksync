<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17"
    android:orientation="vertical">

    <!-- Top Action / Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#151D2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBackHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#94A3B8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Preview &amp; Trim"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVideoMetaHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p • Ready to save"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDurationHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_video_circle"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="00:00"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Video Player Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="340dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#232F42"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:id="@+id/layoutVideoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <VideoView
                        android:id="@+id/videoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- Play / Pause Overlay Button -->
                    <ImageView
                        android:id="@+id/ivPlayPauseOverlay"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/badge_video_circle"
                        android:padding="14dp"
                        android:src="@android:drawable/ic_media_play"
                        app:tint="#FFFFFF" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Video Timeline & Scrubbing Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentPos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBarVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressTint="#38BDF8"
                    android:thumbTint="#38BDF8" />

                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Trimming Section Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#151D2A"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#232F42"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✂️ Trim Video (Lossless)"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Scrub the video and tap 'Set' to trim start/end"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Start Trim Point -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Start Cut:"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTrimStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00.0"
                                android:textColor="#10B981"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSetStart"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="#064E3B"
                                android:text="[ Set Start"
                                android:textColor="#6EE7B7"
                                android:textSize="11sp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <!-- End Trim Point -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="End Cut:"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvTrimEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00.0"
                                android:textColor="#EF4444"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSetEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="#7F1D1D"
                                android:text="Set End ]"
                                android:textColor="#FCA5A5"
                                android:textSize="11sp"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTrimDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Selected Duration: 0.0s"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- 1. Save & Sync to PC (Primary) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveAndSync"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#059669"
                    android:text="⚡ Save &amp; Sync to Laptop"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />

                <!-- 2. Save Locally Only -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveLocal"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#1E293B"
                    android:text="💾 Save to Phone Gallery Only"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    app:cornerRadius="10dp" />

                <!-- 3. Discard -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiscard"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#00000000"
                    android:text="🗑️ Discard Recording"
                    android:textColor="#EF4444"
                    android:textSize="13sp"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
